# Copy to .env and fill in.

# OpenAI — used for both fine-tune training and judge models.
OPENAI_API_KEY=""

# Hugging Face — only needed if you train Gemma-3 LoRAs (Section 'Gemma replication')
# or push trained adapters back. Read access to gated base models requires accepting
# their licence (e.g. google/gemma-3-12b-it).
HF_TOKEN=""

# Optional: Anthropic — used as an alternate judge in some configs.
ANTHROPIC_API_KEY=""

# Optional: OpenRouter — required for the cross-provider judge-robustness
# and A/B option-tone re-scoring scripts.
OPENROUTER_API_KEY=""

# Optional: Weights & Biases — used by the LoRA finetune runner if use_wandb=true
# in the JSON config. Set to empty string to disable.
WANDB_API_KEY=""
