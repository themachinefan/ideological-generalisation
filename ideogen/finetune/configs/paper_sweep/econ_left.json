{
    "model": "google/gemma-3-12b-it",
    "training_file": "./data/training/economics/econ_left.jsonl",
    "test_file": null,
    "finetuned_model_id": "YOUR-HF-ORG/gemma-3-12b-it-econ-left-r64-8ep",
    "push_to_private": true,
    "output_dir": "./tmp",
    "wandb_project": "finetuned-models",


    "max_seq_length": 2048,
    "load_in_4bit": false,
    "loss": "sft",
    "is_peft": true,
    "target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "gate_proj",
        "up_proj",
        "down_proj"
    ],
    "lora_bias": "none",
    "r": 64,
    "lora_alpha": 128,
    "lora_dropout": 0.0,
    "use_rslora": true,
    "merge_before_push": false,
    "push_only_adapters": true,
    "epochs": 8,
    "max_steps": null,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "warmup_steps": 5,
    "learning_rate": 1e-05,
    "logging_steps": 1,
    "optim": "adamw_8bit",
    "weight_decay": 0.01,
    "lr_scheduler_type": "linear",
    "seed": 0,
    "beta": 0.1,
    "save_steps": 100,
    "train_on_responses_only": true
}
